{
  "schema_version": "1.0",
  "model_name": "yolov8n",
  "model_family": "yolov8",
  "task": "detection",
  "model_format": "onnx",
  "num_classes": 80,
  "model_path": "testdata/onnx/yolov8n.onnx",
  "input": {
    "name": "images",
    "shape": [1, 3, 640, 640],
    "dtype": "fp32",
    "layout": "nchw",
    "color": "rgb",
    "normalization": "scale_0_1",
    "resize": "letterbox",
    "interpolation": "bilinear",
    "padding_value": 114.0
  },
  "outputs": [
    {
      "name": "predictions",
      "shape": [1, 84, 8400],
      "dtype": "fp32",
      "semantic": "predictions"
    }
  ],
  "decoder": {
    "protocol": "yolov8_detect_raw",
    "box_format": "cxcywh",
    "box_decode": "decoded_cxcywh",
    "class_selection": "best_class",
    "scores_are_probabilities": true,
    "box_channels": 4,
    "channel_axis": 1
  },
  "nms": {
    "enabled": true,
    "confidence_threshold": 0.25,
    "iou_threshold": 0.45,
    "max_detections": 20,
    "pre_nms_top_k": 300,
    "class_aware": true
  }
}
